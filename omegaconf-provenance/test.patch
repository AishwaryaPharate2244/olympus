+    )
+    merged = OmegaConf.merge(base, override)
+    assert merged.a.qqqqqqqqqqqqq == 10
+    assert OmegaConf.get_provenance(merged, "a") == OmegaConf.get_provenance(base, "a")
+    assert OmegaConf.get_provenance(
+        merged, "a.cccccccccccc"
+    ) == OmegaConf.get_provenance(base, "a.cccccccccccc")
+    assert OmegaConf.get_provenance(
