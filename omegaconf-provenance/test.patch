+        kind="yaml", source=None, line=3, column=5
+    )
+    assert OmegaConf.get_provenance(cfg, "items[2]") == Provenance(
+        kind="yaml", source=None, line=4, column=5
+    )
+
+
+def test_yaml_flow_style_position_c8081c():
+    cfg = OmegaConf.create("x: {p: 1, q: 2}\ny: [7, 8]\n")
+    assert OmegaConf.get_provenance(cfg, "x") == Provenance(
+        kind="yaml", source=None, line=1, column=4
+    )
+    assert OmegaConf.get_provenance(cfg, "x.p") == Provenance(
+        kind="yaml", source=None, line=1, column=8
