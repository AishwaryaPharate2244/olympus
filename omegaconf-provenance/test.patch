+def test_provenance_diff_changed_added_unchanged_c8081c():
+    before = OmegaConf.create("a:\n  qqqqqqqqqqqqq: 1\n  cccccccccccc: 2\n")
+    after = OmegaConf.merge(
+        before, OmegaConf.create("a:\n  eeeeeeeeeeeeeeeeeeeee: true\n  qqqqqqqqqqqqq: 10\n")
+    )
+    diff = OmegaConf.provenance_diff(before, after)
+    assert "a.qqqqqqqqqqqqq" in diff
+    assert "a.eeeeeeeeeeeeeeeeeeeee" in diff
+    assert "a.cccccccccccc" not in diff
+    before_prov, after_prov = diff["a.qqqqqqqqqqqqq"]
+    assert before_prov == OmegaConf.get_provenance(before, "a.qqqqqqqqqqqqq")
+    assert after_prov == OmegaConf.get_provenance(after, "a.qqqqqqqqqqqqq")
+    added_before, added_after = diff["a.eeeeeeeeeeeeeeeeeeeee"]
+    assert added_before is None
+    assert added_after == OmegaConf.get_provenance(after, "a.eeeeeeeeeeeeeeeeeeeee")
+
