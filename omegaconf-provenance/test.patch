+        kind="yaml", source=None, line=1, column=4
+    )
+    assert OmegaConf.get_provenance(cfg, "b") == Provenance(
+        kind="yaml", source=None, line=2, column=4
+    )
+
+
+def test_yaml_nested_mapping_position_c8081c():
+    cfg = OmegaConf.create("outer:\n  inner: 42\n")
+    assert OmegaConf.get_provenance(cfg, "outer") == Provenance(
+        kind="yaml", source=None, line=2, column=3
+    )
+    assert OmegaConf.get_provenance(cfg, "outer.inner") == Provenance(
+        kind="yaml", source=None, line=2, column=10
+    )
+
+
+def test_yaml_root_position_c8081c():
+    cfg = OmegaConf.create("a: 1\n")
