--- /dev/null
+++ b/test.sh
@@ -0,0 +1,78 @@
+#!/usr/bin/env bash
+set -uo pipefail
+OUTPUT_PATH=""
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --output_path) OUTPUT_PATH="$2"; shift 2 ;;
+    *) break ;;
+  esac
+done
+MODE="${1:-}"
+cd /app
+
+TESTFILE="test_provenance_c8081c.py"
+
+emit_names_failure() {
+  local emitter
+  emitter="$(mktemp)"
+  cat > "$emitter" <<'PYEOF'
+import re
+import sys
+import xml.sax.saxutils as sax
+
+output_path, test_file = sys.argv[1], sys.argv[2]
+log = sys.stdin.read()
+
+with open(test_file, encoding="utf-8") as f:
+    source = f.read()
+names = re.findall(r"^def (test_\w+)\(", source, re.MULTILINE)
+
+
+def strip_illegal_xml_chars(text):
+    return "".join(
+        c
+        for c in text
+        if c in ("\t", "\n", "\r")
+        or (0x20 <= ord(c) <= 0xD7FF)
+        or (0xE000 <= ord(c) <= 0xFFFD)
+    )
+
+
+body = sax.escape(strip_illegal_xml_chars(log))
+cases = "".join(
+    '<testcase classname="{}" name="{}">'
+    '<failure message="build failure">{}</failure></testcase>'.format(
+        sax.escape(test_file), sax.escape(name), body
+    )
+    for name in names
+)
+xml_doc = (
+    '<?xml version="1.0" encoding="utf-8"?>'
+    '<testsuites><testsuite name="{}" tests="{}" failures="{}" '
+    'errors="0" skipped="0">{}</testsuite></testsuites>'
+).format(sax.escape(test_file), len(names), len(names), cases)
+
+with open(output_path, "w", encoding="utf-8") as f:
+    f.write(xml_doc)
+PYEOF
+  python3 "$emitter" "$OUTPUT_PATH" "$TESTFILE"
+  rm -f "$emitter"
+}
+
+case "$MODE" in
+  base) TEST_TARGET="tests" ;;
+  new) TEST_TARGET="$TESTFILE" ;;
+  *)
+    echo "Usage: ./test.sh [--output_path <path>] [base|new]" >&2
+    exit 1
+    ;;
+esac
+
+RUN_LOG=$(python -m pytest "$TEST_TARGET" -v --junitxml="$OUTPUT_PATH" 2>&1)
+RESULT=$?
+
+if [ "$MODE" = "new" ] && [ "$RESULT" -eq 2 ]; then
+  printf '%s' "$RUN_LOG" | emit_names_failure
+fi
+
+exit $RESULT
