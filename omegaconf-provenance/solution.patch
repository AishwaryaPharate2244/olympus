+
+def to_annotated_container(node: Node) -> dict[str, Any]:
+    descend = _unwrap_union_node(node)
+    if isinstance(descend, DictConfig) and not (
+        descend._is_none() or descend._is_missing() or descend._is_interpolation()
+    ):
+        annotated_dict = {}
+        for key in descend.keys():
+            child = descend._get_node(key, validate_access=False)
+            if isinstance(child, Node):
+                annotated_dict[key] = to_annotated_container(child)
+        value: Any = annotated_dict
+    elif isinstance(descend, ListConfig) and not (
+        descend._is_none() or descend._is_missing() or descend._is_interpolation()
+    ):
+        annotated_list = []
+        for index in range(len(descend)):
+            child = descend._get_node(index, validate_access=False)
+            if isinstance(child, Node):
+                annotated_list.append(to_annotated_container(child))
+        value = annotated_list
+    else:
+        value = _get_value(node)
+    return {"value": value, "provenance": _provenance_to_dict(node._get_provenance())}
