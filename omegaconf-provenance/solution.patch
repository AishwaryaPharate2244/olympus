+    if isinstance(descend, DictConfig) and not (
+        descend._is_none() or descend._is_missing() or descend._is_interpolation()
+    ):
+        for key in descend.keys():
+            child = descend._get_node(key, validate_access=False)
+            if isinstance(child, Node):
+                yield from iter_provenance_tree(
+                    child, _append_provenance_key(prefix, key)
+                )
+    elif isinstance(descend, ListConfig) and not (
+        descend._is_none() or descend._is_missing() or descend._is_interpolation()
+    ):
+        for index in range(len(descend)):
+            child = descend._get_node(index, validate_access=False)
+            if isinstance(child, Node):
