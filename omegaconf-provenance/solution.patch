@@ -308,3 +310,57 @@ def get_yaml_loader(
     )
 
     return loader
+
+
+class YamlPosition:
+    __slots__ = ("provenance", "children")
+
+    def __init__(
+        self,
+        provenance: Provenance,
+        children: "dict[Any, YamlPosition] | list[YamlPosition] | None",
+    ) -> None:
+        self.provenance = provenance
+        self.children = children
+
+
+def _yaml_node_provenance(node: yaml.Node, source: str | None, kind: str) -> Provenance:
+    mark = node.start_mark
+    return Provenance(
+        kind=kind, source=source, line=mark.line + 1, column=mark.column + 1
+    )
+
+
+def _build_yaml_position(
+    node: yaml.Node, loader: Any, source: str | None, kind: str
+) -> YamlPosition:
+    provenance = _yaml_node_provenance(node, source, kind)
+    if isinstance(node, yaml.MappingNode):
+        mapping_children: dict[Any, YamlPosition] = {}
+        for key_node, value_node in node.value:
+            key = loader.construct_object(key_node)
+            mapping_children[key] = _build_yaml_position(
+                value_node, loader, source, kind
+            )
+        return YamlPosition(provenance, mapping_children)
+    if isinstance(node, yaml.SequenceNode):
+        sequence_children = [
+            _build_yaml_position(child, loader, source, kind) for child in node.value
+        ]
+        return YamlPosition(provenance, sequence_children)
+    return YamlPosition(provenance, None)
+
+
+def load_yaml_with_provenance(
+    stream: Any, loader_cls: Any, source: str | None, kind: str
+) -> "tuple[Any, YamlPosition | None]":
+    loader = loader_cls(stream)
+    try:
+        node = loader.get_single_node()
+        if node is None:
+            return None, None
+        obj = loader.construct_document(node)
+        position = _build_yaml_position(node, loader, source, kind)
+        return obj, position
+    finally:
+        loader.dispose()
